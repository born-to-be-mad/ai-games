# Active AI provider (ollama | openai | anthropic)
AI_PROVIDER_ACTIVE=ollama

# Ollama base URL (only needed when not using --profile ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Weather API Keys
WEATHERAPI_KEY=your_weatherapi_key_here
OPENWEATHERMAP_KEY=your_openweathermap_key_here

# News API Keys
THENEWSAPI_KEY=your_thenewsapi_key_here
GNEWS_KEY=your_gnews_key_here
NEWSAPI_KEY=your_newsapi_key_here

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
