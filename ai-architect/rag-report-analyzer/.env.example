# AI Provider — openai | anthropic | ollama
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Vector Store — simple | chroma
VECTORSTORE_TYPE=simple

# ChromaDB (used when VECTORSTORE_TYPE=chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Prediction mode — NARRATIVE_PREDICTION | LINEAR_REGRESSION | HYBRID
PREDICTION_MODE=NARRATIVE_PREDICTION

# Startup ingestion — set to true to auto-ingest the sample PDF on app start.
# When false (default), upload reports via the UI or POST /api/v1/ingest.
INGEST_ON_START=false
SAMPLE_PDF_PATH=../tmp/NVIDIA-2025-Annual-Report.pdf
INGEST_TICKER=NVDA
INGEST_YEAR=2025
INGEST_QUARTER=Annual

# PostgreSQL (used when SPRING_PROFILES_ACTIVE=postgres)
# Start with: docker compose --profile postgres up
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
# SPRING_PROFILES_ACTIVE=postgres
