# AI Provider — openai | anthropic | ollama
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Vector Store — simple | chroma
VECTORSTORE_TYPE=simple

# ChromaDB (used when VECTORSTORE_TYPE=chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Prediction mode — NARRATIVE_PREDICTION | LINEAR_REGRESSION | HYBRID
PREDICTION_MODE=NARRATIVE_PREDICTION

# Sample report for ingestion runner (Phase 1)
SAMPLE_PDF_PATH=../tmp/NVIDIA-2025-Annual-Report.pdf
