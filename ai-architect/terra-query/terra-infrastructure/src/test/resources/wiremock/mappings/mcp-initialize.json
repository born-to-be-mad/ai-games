{
  "name": "MCP initialize",
  "request": {
    "method": "POST",
    "urlPattern": ".*",
    "bodyPatterns": [
      { "matches": "(?s).*\\\"method\\\"\\s*:\\s*\\\"initialize\\\".*" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "transformers": ["response-template"],
    "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"{{jsonPath request.body '$.id'}}\",\n  \"result\": {\n    \"protocolVersion\": \"2024-11-05\",\n    \"serverInfo\": { \"name\": \"terra-mcp\", \"version\": \"1.0.0\" },\n    \"capabilities\": { \"tools\": {} }\n  }\n}"
  }
}
