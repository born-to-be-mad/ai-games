# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: openai | anthropic | ollama
LLM_PROVIDER=ollama

# ── API Keys (fill in and uncomment the one matching LLM_PROVIDER) ────────────
#OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...

# ── Models ────────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_MODEL=llama3.2
